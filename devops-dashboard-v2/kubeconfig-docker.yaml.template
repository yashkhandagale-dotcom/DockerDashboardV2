# kubeconfig-docker.yaml.template
#
# FIX #1 & #2 — This is a TEMPLATE. Do NOT put real credentials here.
# The real kubeconfig-docker.yaml is in .gitignore and must be generated locally.
#
# HOW TO GENERATE YOUR LOCAL kubeconfig-docker.yaml:
# ─────────────────────────────────────────────────
# After running `minikube start`, run this command:
#
#   minikube update-kubeconfig          # ensures it's current
#   cp ~/.kube/config ./kubeconfig-docker.yaml
#
# FIX #1 — The server IP in the generated file will be your current Minikube IP.
# If Minikube restarts and the IP changes, regenerate this file:
#
#   minikube ip                          # check current IP
#   cp ~/.kube/config ./kubeconfig-docker.yaml
#
# ─────────────────────────────────────────────────
apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: <REPLACE_WITH_REAL_VALUE>
    server: https://<MINIKUBE_IP>:8443    # run: minikube ip
  name: minikube
contexts:
- context:
    cluster: minikube
    namespace: default
    user: minikube
  name: minikube
current-context: minikube
kind: Config
users:
- name: minikube
  user:
    client-certificate-data: <REPLACE_WITH_REAL_VALUE>
    client-key-data: <REPLACE_WITH_REAL_VALUE>
